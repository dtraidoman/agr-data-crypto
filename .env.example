# --- role ---------------------------------------------------------------
# alpha = primary Binance, bravo = primary Bybit
COLLECTOR_ROLE=alpha
COLLECTOR_INTERVAL=1m

# --- coordination (Upstash Redis, rediss://) ----------------------------
COLLECTOR_REDIS_URL=rediss://default:password@host.upstash.io:6379

# --- data sink (Supabase PostgREST) -------------------------------------
COLLECTOR_SUPABASE_URL=https://xxxx.supabase.co
COLLECTOR_SUPABASE_KEY=service-role-key
COLLECTOR_SUPABASE_TABLE=ohlcv

# --- timing -------------------------------------------------------------
# 3h50m soft deadline; job timeout is 4h25m.
# Intervals are tuned for the Upstash free tier: ~5.8k commands/day for both
# roles. Faster coordination costs money and buys nothing at 1m granularity.
COLLECTOR_SOFT_DEADLINE_SEC=13800
COLLECTOR_DRAIN_RESERVE_SEC=60
COLLECTOR_LEASE_TTL_MS=180000
COLLECTOR_HEARTBEAT_TTL_MS=300000
COLLECTOR_HEARTBEAT_INTERVAL_SEC=60
COLLECTOR_CURSOR_FLUSH_INTERVAL_SEC=120
COLLECTOR_TAKEOVER_POLL_INTERVAL_SEC=120
COLLECTOR_TAKEOVER_GRACE_SEC=120
COLLECTOR_STARTUP_GRACE_SEC=900
COLLECTOR_STANDBY_MAX_WAIT_SEC=600
COLLECTOR_DEGRADED_MAX_SEC=900

# --- exchange clients ---------------------------------------------------
COLLECTOR_REST_MIN_INTERVAL_SEC=0.3
COLLECTOR_REST_TIMEOUT_SEC=15
COLLECTOR_REST_MAX_PAGES=10
COLLECTOR_WS_PLANNED_RECONNECT_SEC=21600
COLLECTOR_WS_RECONNECT_MAX_SEC=30
COLLECTOR_COLD_START_CANDLES=60
COLLECTOR_ENABLE_TRADES=false

# --- sink batching ------------------------------------------------------
COLLECTOR_FLUSH_ROWS=200
COLLECTOR_FLUSH_INTERVAL_SEC=5

# --- alerts -------------------------------------------------------------
COLLECTOR_TELEGRAM_BOT_TOKEN=
COLLECTOR_TELEGRAM_CHAT_ID=

# --- misc ---------------------------------------------------------------
COLLECTOR_LOG_LEVEL=INFO
COLLECTOR_DRY_RUN=false
