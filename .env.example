# Copy to your shell environment or a local .env file. Never commit real values.
# The collector reads process environment variables; it does not load .env itself.

# alpha = primary Binance, secondary Bybit
# bravo = primary Bybit, secondary Binance
COLLECTOR_ROLE=alpha
# COLLECTOR_RUN_ID=local-dev

COLLECTOR_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
COLLECTOR_ENABLE_LIQUIDATIONS=true

# Upstash Redis (TLS URL, rediss://...). Required for A/B lease handoff.
COLLECTOR_REDIS_URL=rediss://default:REPLACE_ME@example.upstash.io:6379

# Supabase project URL and service-role key. The service-role key bypasses RLS;
# keep it in GitHub Secrets or a local environment only.
COLLECTOR_SUPABASE_URL=https://REPLACE_ME.supabase.co
COLLECTOR_SUPABASE_KEY=REPLACE_ME_SERVICE_ROLE_KEY

# Run length and A/B liveness. Keep lease TTL >= 2 heartbeat intervals.
COLLECTOR_SOFT_DEADLINE_SEC=16200
COLLECTOR_LEASE_TTL_MS=180000
COLLECTOR_HEARTBEAT_SEC=60
COLLECTOR_TAKEOVER_POLL_SEC=60
COLLECTOR_STARTUP_GRACE_SEC=120

# 5-minute OI/long-short polling.
COLLECTOR_METRICS_POLL_SEC=300
COLLECTOR_METRICS_STARTUP_LOOKBACK_SEC=86400
COLLECTOR_METRICS_OVERLAP_SEC=900

# CVD live warmup window. The REST endpoints have finite recent-trade pages;
# daily reconciliation repairs the previous UTC day from exchange archives.
COLLECTOR_TRADE_LOOKBACK_MIN=10

# Shared REST pacing and retries.
COLLECTOR_REST_MIN_INTERVAL_SEC=0.25
COLLECTOR_REST_TIMEOUT_SEC=20
COLLECTOR_REST_MAX_RETRIES=4

# WebSocket reconnect behavior.
COLLECTOR_WS_PLANNED_RECONNECT_SEC=21600
COLLECTOR_WS_RECONNECT_MAX_SEC=30

# Write buffer.
COLLECTOR_FLUSH_ROWS=500
COLLECTOR_FLUSH_INTERVAL_SEC=5
COLLECTOR_MAX_BUFFERED_ROWS=50000

# Optional Telegram notifications.
COLLECTOR_TELEGRAM_BOT_TOKEN=
COLLECTOR_TELEGRAM_CHAT_ID=

COLLECTOR_LOG_LEVEL=INFO
COLLECTOR_DRY_RUN=false
